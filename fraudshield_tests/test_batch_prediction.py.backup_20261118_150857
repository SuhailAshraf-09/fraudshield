ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / "data" / "processed" / "test.csv"
REPORT = ROOT / "reports" / "phase5" / "batch_test.json"

BASE = "http://127.0.0.1:8000/api/v1"

FEATURES = ["Time", "Amount"] + [
    f"V{i}" for i in range(1, 29)
]

df = pd.read_csv(DATA, nrows=3)

csv_bytes = df[FEATURES].to_csv(index=False).encode("utf-8")

email = input("Admin email: ")
password = getpass("Admin password: ")

with httpx.Client(timeout=60) as client:
    login = client.post(
        BASE + "/auth/login",
        json={"email": email, "password": password}
    )

    del password

    if login.status_code != 200:
        raise SystemExit(f"Login failed: {login.status_code}")

    token = login.json()["access_token"]
    headers = {"Authorization": f"Bearer {token}"}

    # Request without authorization
    unauthorized = client.post(
        BASE + "/ml/batch-predict",
        files={"file": ("sample.csv", csv_bytes, "text/csv")}
    )

    # Authenticated CSV batch prediction
    prediction = client.post(
        BASE + "/ml/batch-predict",
        headers=headers,
        files={"file": ("sample.csv", csv_bytes, "text/csv")}
    )

    # Invalid CSV schema
    invalid_bytes = df[FEATURES].drop(
        columns=["Amount"]
    ).to_csv(index=False).encode("utf-8")

    invalid = client.post(
        BASE + "/ml/batch-predict",
        headers=headers,
        files={"file": ("invalid.csv", invalid_bytes, "text/csv")}
    )

results = {
    "login_status": login.status_code,
    "unauthorized_status": unauthorized.status_code,
    "batch_prediction_status": prediction.status_code,
    "invalid_schema_status": invalid.status_code
}

if prediction.status_code == 200:
    data = prediction.json()
    results["total_transactions"] = data["total_transactions"]
    results["flagged_transactions"] = data["flagged_transactions"]
    results["model_version"] = data["model_version"]
else:
    print("Prediction error:", prediction.text[:500])

results["checks_passed"] = (
    login.status_code == 200
    and unauthorized.status_code == 401
    and prediction.status_code == 200
    and invalid.status_code == 422
    and results.get("total_transactions") == 3
)

