# Local development defaults only. Use PostgreSQL in deployment.
DATABASE_URL=sqlite:///./fraudshield_dev.db
# Use: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_DB_PASSWORD
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:8000
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://fraudshield:YOUR_PASSWORD@localhost:5432/fraudshield
